# Stage 1: Frontend (sempre em amd64)
FROM --platform=linux/amd64 node:22-alpine AS frontend-builder
RUN npm install -g pnpm@latest
WORKDIR /app
COPY . .
RUN pnpm install --fetch-timeout 300000 --ignore-scripts
RUN pnpm build

# Stage 2: Backend Go (cross-compile para riscv64)
FROM --platform=linux/amd64 golang:1.26-alpine AS backend-builder
RUN apk add --no-cache git gcc musl-dev
WORKDIR /app
COPY . .
RUN go mod download
ENV GOOS=linux \
    GOARCH=riscv64 \
    CGO_ENABLED=0
RUN go build \
    -ldflags="-s -w" \
    -o portainer \
    ./api/cmd/portainer/

# Stage 3: Imagem final riscv64
FROM --platform=linux/riscv64 alpine:3.20
LABEL maintainer="isacndevops"
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /
COPY --from=backend-builder /app/portainer /portainer
COPY --from=frontend-builder /app/dist/public /public
VOLUME ["/data"]
EXPOSE 9000 9443 8000
ENTRYPOINT ["/portainer"]
